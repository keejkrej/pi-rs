#!/bin/bash
# Semaphore-wrapped cargo: at most $PI_PORT_CARGO_SLOTS concurrent cargo invocations machine-wide (RAM limit).
# Call it by absolute path; do not put this bin dir on PATH.
HOME_DIR=${PI_PORT_HOME:-$(cd "$(dirname "$0")/.." && pwd)}
SLOTS=${PI_PORT_CARGO_SLOTS:-2}
REAL=${PI_PORT_REAL_CARGO:-$(command -v cargo)}
[ -z "$REAL" ] || [ "$REAL" -ef "$0" ] && { echo "pi-port cargo wrapper: set PI_PORT_REAL_CARGO" >&2; exit 2; }
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-5}
mkdir -p "$HOME_DIR/slots"
while true; do
  for i in $(seq 1 "$SLOTS"); do
    d=$HOME_DIR/slots/cargo-$i
    if mkdir "$d" 2>/dev/null; then
      echo $$ > "$d/pid"
      trap 'rm -rf "$d"' EXIT INT TERM HUP
      "$REAL" "$@"
      exit $?
    fi
    p=$(cat "$d/pid" 2>/dev/null)
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$d"; fi
  done
  sleep 3
done
