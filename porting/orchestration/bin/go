#!/bin/bash
# Semaphore-wrapped go: at most $PI_PORT_GO_SLOTS concurrent go build/test/vet invocations (RAM limit). env/version/list/doc/fmt bypass.
# Call it by absolute path; do not put this bin dir on PATH.
HOME_DIR=${PI_PORT_HOME:-$(cd "$(dirname "$0")/.." && pwd)}
REAL=${PI_PORT_REAL_GO:-$(command -v go)}
[ -z "$REAL" ] || [ "$REAL" -ef "$0" ] && { echo "pi-port go wrapper: set PI_PORT_REAL_GO" >&2; exit 2; }
case "$1" in env|version|list|doc|fmt) exec "$REAL" "$@";; esac
SLOTS=${PI_PORT_GO_SLOTS:-3}
export GOFLAGS="${GOFLAGS:--p=4}"
export CGO_ENABLED=${CGO_ENABLED:-0}
mkdir -p "$HOME_DIR/slots"
while true; do
  for i in $(seq 1 "$SLOTS"); do
    d=$HOME_DIR/slots/go-$i
    if mkdir "$d" 2>/dev/null; then
      echo $$ > "$d/pid"
      trap 'rm -rf "$d"' EXIT INT TERM HUP
      "$REAL" "$@"
      exit $?
    fi
    p=$(cat "$d/pid" 2>/dev/null)
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then rm -rf "$d"; fi
  done
  sleep 2
done
